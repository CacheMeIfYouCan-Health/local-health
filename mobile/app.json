{
  "expo": {
    "name": "LocalHealth",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "mobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cobekodes.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocalHealth uses your location to find clinics, hospitals and pharmacies near you and save them for offline use."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b57da44-cff7-472e-8aba-a0bafcd8f585"
      }
    }
  }
}
