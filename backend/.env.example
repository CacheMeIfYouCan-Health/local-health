# Postgres (Neon). For a local Postgres add ?sslmode=disable or set PGSSLMODE=disable.
DATABASE_URL=
JWT_SECRET=
# Comma-separated front-end origins allowed by CORS and Socket.IO.
CORS_ORIGIN=http://localhost:3000
PORT=4000

# --- Forum ---
# Updates count as "At facility" when posted within this many metres.
FORUM_VERIFY_RADIUS_METERS=500

# AI summaries (Anthropic). Without credentials the forum works, summaries are skipped.
ANTHROPIC_API_KEY=
# FORUM_SUMMARY_MODEL=claude-opus-5-5
# FORUM_SUMMARY_JOB_MINUTES=20     # how often the batch job runs
# FORUM_SUMMARY_WINDOW=70          # "summary of the past N messages"
# FORUM_SUMMARY_MIN_NEW=5          # new updates needed before re-summarising
# FORUM_SUMMARY_REFRESH_MINUTES=120

# Browser push notifications. Generate a pair with `npm run vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain
# FORUM_NOTIFY_JOB_MINUTES=5
# DISABLE_JOBS=true                # turn off background jobs (e.g. on extra instances)
